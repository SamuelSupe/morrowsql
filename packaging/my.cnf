[mysqld]
# Replace both paths with absolute paths before starting the server.
basedir=/opt/morrowsql
datadir=/var/lib/morrowsql
socket=/var/lib/morrowsql/mysql.sock
pid-file=/var/lib/morrowsql/mysql.pid
log-error=/var/lib/morrowsql/error.log
bind-address=127.0.0.1
mysqlx-bind-address=127.0.0.1

[client]
socket=/var/lib/morrowsql/mysql.sock
